# Home-server API runtime for api.research-os.org. Do not use in Cloudflare Pages.
NODE_ENV=production
SITE_URL=https://research-os.org
FRONTEND_ORIGIN=https://research-os.org
NEXT_PUBLIC_API_BASE_URL=https://api.research-os.org
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
DATABASE_URL=postgresql://researchos:replace-with-a-long-password@127.0.0.1:5433/researchos
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEARCHOS_AUTH_MODE=required
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MCP_SERVERS_JSON=[{"name":"claude-web-search","command":"node","args":["mcp/claude-web-search-server.mjs"]}]
RESEARCHOS_DEMO_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PACK_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
