{
  "name": "researchos",
  "version": "0.2.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@researchos/web",
    "dev:api": "npm run dev --workspace=@researchos/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace=@researchos/web",
    "build:api": "npm run build --workspace=@researchos/api",
    "start:api": "npm run start --workspace=@researchos/api",
    "lint": "eslint apps",
    "test": "vitest run",
    "test:db": "npm run test:db --workspace=@researchos/api",
    "db:migrate": "npm run db:migrate --workspace=@researchos/api",
    "test:mcp": "node apps/api/scripts/smoke-local-mcp.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "15.5.2",
    "vitest": "^3.2.4"
  }
}
