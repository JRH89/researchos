# The only committed environment template. Copy it to .env.local for local work.
# In production, set the applicable values in the API service environment and
# Cloudflare Pages dashboard. Never commit a real .env file.

# Shared public URLs. NEXT_PUBLIC_* values are safe for the Pages frontend.
SITE_URL=https://research-os.org
FRONTEND_ORIGIN=https://research-os.org
NEXT_PUBLIC_API_BASE_URL=https://api.research-os.org

# Firebase Authentication. These NEXT_PUBLIC values go in Cloudflare Pages too.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API server only. Run MCP child processes from the repository root.
MCP_SERVERS_JSON=[{"name":"claude-web-search","command":"node","args":["mcp/claude-web-search-server.mjs"]},{"name":"local-research-corpus","command":"node","args":["mcp/local-research-server.mjs"]}]
RESEARCHOS_DEMO_MODE=false

# Optional OpenAI-compatible adapter. Claude takes precedence if both are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

# Claude Messages API. Required for live web search and synthesis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# API server only. Apply all migrations with: npm.cmd run db:migrate
DATABASE_URL=postgresql://researchos:replace-with-a-long-password@127.0.0.1:5433/researchos
# API server only. One-line JSON from Firebase service-account credentials; never place on Pages.
FIREBASE_SERVICE_ACCOUNT_JSON=
RESEARCHOS_AUTH_MODE=required
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PACK_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=

# Cloudflare Pages receives only: SITE_URL, NEXT_PUBLIC_API_BASE_URL, and the
# four NEXT_PUBLIC_FIREBASE_* values. Everything else stays on the API server.
